---
/**
 * EmptyState — a bordered card for "nothing here yet": a title, one or two
 * lines of help, and the next steps (the default slot: a secondary and a
 * primary Button). Calm and centred, with room but no illustration. The
 * title is a heading at `level` (default h2) so it is in the page outline.
 */
import Icon, { type IconName } from "./site-icon.astro";

interface Props {
  title: string;
  message?: string;
  icon?: IconName;
  level?: 2 | 3 | 4;
}
const { title, message, icon, level = 2 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3" | "h4";
---

<div class="flex flex-col items-center gap-2 rounded-md border border-border bg-card px-6 py-12 text-center" data-slot="empty-state">
  {
    icon && (
      <span class="mb-1 inline-flex h-9 w-9 items-center justify-center rounded-sm border border-border text-muted-foreground">
        <Icon name={icon} class="h-4 w-4" />
      </span>
    )
  }
  <Heading class="text-h6 font-semibold">{title}</Heading>
  {message && <p class="max-w-prose text-body-sm text-muted-foreground">{message}</p>}
  {
    Astro.slots.has("default") && (
      <div class="mt-3 flex flex-wrap items-center justify-center gap-2">
        <slot />
      </div>
    )
  }
</div>
