---
/**
 * Input — the Dashboard Standard input (`contracts/app/input`), pure Astro: a native
 * <input>, 36px (48px on touch). Every attribute other than `class` is passed
 * through (name, type, value, required, autocomplete, aria-*, …). Classes are
 * `appInputClasses`. Its React twin is `app-input.tsx`; the registry primitive is
 * `./input.astro`.
 */
import type { HTMLAttributes } from "astro/types";

import { cn } from "./ui-utils";
import { appInputClasses } from "./ui-variants";

type Props = HTMLAttributes<"input">;
const { class: extra, ...attrs } = Astro.props;
---

<input data-slot="input" class={cn(appInputClasses, extra as string | undefined)} {...attrs} />
