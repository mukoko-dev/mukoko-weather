---
/**
 * PageHeader — a page's title with an optional "View docs" pill, one line
 * of description, breadcrumbs and actions. Compact, like a product
 * console: a 20px title, no rule under it. The one <h1> on an app page.
 */
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  description?: string;
  crumbs?: Crumb[];
  /** Link to the page's documentation, shown as a small pill. */
  docsHref?: string;
  docsLabel?: string;
}
const { title, description, crumbs = [], docsHref, docsLabel = "View docs" } = Astro.props;
---

<header class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between" data-slot="page-header">
  <div class="min-w-0">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-1">
          <ol class="flex flex-wrap items-center gap-1 text-caption text-muted-foreground">
            {crumbs.map((c, i) => (
              <li class="flex items-center gap-1">
                {i > 0 && <span aria-hidden="true">/</span>}
                {c.href ? (
                  <a class="underline-offset-4 hover:text-foreground hover:underline" href={c.href}>
                    {c.label}
                  </a>
                ) : (
                  <span aria-current="page">{c.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
      <h1 class="text-h5 font-semibold tracking-tight">{title}</h1>
      {
        docsHref && (
          <a href={docsHref} class="inline-flex h-6 items-center rounded-full border border-border px-2.5 text-caption font-medium hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" data-slot="docs-pill">
            {docsLabel}
            <span class="sr-only"> for {title}</span>
          </a>
        )
      }
    </div>
    {description && <p class="mt-1 max-w-prose text-body-sm text-muted-foreground">{description}</p>}
  </div>
  {Astro.slots.has("actions") && <div class="flex shrink-0 flex-wrap gap-2"><slot name="actions" /></div>}
</header>
