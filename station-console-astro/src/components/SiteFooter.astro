---
import { COMPANY_LINE, FOOTER_LINKS, TAGLINE } from "../lib/links";
---

<footer role="contentinfo" class="border-t border-border" data-slot="site-footer">
  <div class="container-custom space-y-3 py-6 text-caption text-muted-foreground">
    <ul role="list" class="flex flex-wrap gap-x-4 gap-y-1">
      {
        FOOTER_LINKS.map((l) => (
          <li>
            <a href={l.href} class="inline-flex min-h-8 items-center underline-offset-4 hover:text-foreground hover:underline pointer-coarse:min-h-12">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p>{COMPANY_LINE}. {TAGLINE}</p>
  </div>
</footer>
