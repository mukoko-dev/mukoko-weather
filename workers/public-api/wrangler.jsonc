// mukoko-weather-api: the public weather API (mukoko-dev/mukoko-weather#148).
// Callers: the Mukoko Weather app (CORS), developers, and mukoko-api, which
// adds a service binding to this Worker for consumer reuse:
//   "services": [{ "binding": "WEATHER", "service": "mukoko-weather-api" }]
//
// No secrets: a developer's own Nyuchi API key is forwarded to the Nyuchi
// API (GET /v1/weather/key), which checks it. Vars: ENVIRONMENT,
// CORS_ORIGINS, NYUCHI_API_URL.
{
  "name": "mukoko-weather-api",
  "main": "build/index.js",
  "compatibility_date": "2026-09-15",
  "build": { "command": "worker-build --release" },
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true },
  },
  "routes": [{ "pattern": "weather-api.mukoko.com", "custom_domain": true }],
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ORIGINS": "https://weather.mukoko.com,https://weatherstations.nyuchi.com",
    "NYUCHI_API_URL": "https://api.nyuchi.com",
  },
  "services": [
    { "binding": "FORECAST", "service": "mukoko-weather-forecast" },
    { "binding": "AVIATION", "service": "mukoko-weather-aviation" },
    { "binding": "PLACES", "service": "mukoko-weather-places" },
    // Shamwari Weather: /v1/ai/* is forwarded here.
    { "binding": "AI_SERVICE", "service": "mukoko-weather-ai" },
  ],
  // Per client IP. Service-binding callers share one key, so mukoko-api
  // must apply its own per-consumer limits.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1481",
      "simple": { "limit": 120, "period": 60 },
    },
    // Per developer key (key id), for callers with a Nyuchi API key scoped
    // for `weather`. Monthly quotas are the Nyuchi API's.
    {
      "name": "KEY_RATE_LIMITER",
      "namespace_id": "1484",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
}
