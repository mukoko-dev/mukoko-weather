// mukoko-weather-ai: Shamwari Weather (mukoko-dev/mukoko-weather#148).
// No route and no workers.dev address. Reached over service bindings
// (AI_SERVICE) only: mukoko-weather-api forwards /v1/ai/*, and
// mukoko-weather-internal forwards the signed-in app's calls
// (/internal/summary, ...) and the Python backend's model calls (/internal/
// chat/completions) after checking its service key.
//
// Every model call goes through the `shamwari` AI Gateway (Guardrails on,
// logging off) to an open-weights Workers AI model. The guardrails block
// comes from the Nyuchi API; without one the Worker refuses (fails closed).
//
// Names only, never values:
//   secrets: NYUCHI_API_KEY (internal key, `ai` scope), from the Secrets
//            Store as MUKOKO_WEATHER_NYUCHI_API_KEY (below)
//   vars:    NYUCHI_API_URL, AI_MODEL (a @cf/ model; Z.ai GLM, a reasoning
//            model with function calling)
// OWNER: replace the placeholder ids below with the created resources'
// ids (workers/README.md, "Owner steps").
{
  "name": "mukoko-weather-ai",
  "main": "build/index.js",
  "compatibility_date": "2026-09-15",
  "build": { "command": "worker-build --release" },
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  // Invocation metadata only. The code logs no prompts, answers or keys.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true },
  },
  // Secrets: the account's Cloudflare Secrets Store (the store id is not a
  // credential). Each secret must be in the store with the "workers" scope.
  // The code reads them by plain name through weather_edge::secret.
  // TRANSITION: until the owner confirms every value is in the store, the
  // code falls back to the plain wrangler secret of the plain name
  // (warning once per isolate); remove the fallback and the plain secrets
  // then. The binding names differ from the plain names because two
  // bindings on a Worker may not share a name.
  "secrets_store_secrets": [
    {
      "binding": "MUKOKO_WEATHER_NYUCHI_API_KEY",
      "store_id": "56f84bfa8a564c54a95dbf4f4b4281b4",
      "secret_name": "MUKOKO_WEATHER_NYUCHI_API_KEY",
    },
  ],
  "vars": {
    "NYUCHI_API_URL": "https://api.nyuchi.com",
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
  },
  "ai": { "binding": "AI" },
  "services": [
    { "binding": "FORECAST", "service": "mukoko-weather-forecast" },
    // The history analysis reads the same history the app shows (recorded days,
    // archive days, and a fetch for the rest). Deploy places BEFORE this Worker.
    { "binding": "PLACES", "service": "mukoko-weather-places" },
  ],
  "kv_namespaces": [
    // Summaries (30, 60 or 120 min by tag, 1 min for fallback text) and
    // history analyses (1 h).
    { "binding": "AI_CACHE", "id": "b0576f0244c0465d96a816a776e44e18" },
  ],
  "d1_databases": [
    {
      // rate_events (migration 0002) holds the signed-in person's hourly
      // model budgets (weather_core::budget: ai-summary, ...). Rows hold a
      // hash of the person id or IP, never the id. Nothing else is read or
      // written.
      "binding": "WEATHER_DB",
      "database_name": "mukoko-weather",
      "database_id": "9a8846ea-ee34-4479-bc4c-790ee2beabee",
      "migrations_dir": "../d1/migrations",
    },
  ],
  // Per client IP (CF-Connecting-IP, passed on by mukoko-weather-api): the
  // public routes only.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1482",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
