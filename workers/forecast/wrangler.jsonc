// mukoko-weather-forecast: provider aggregation (mukoko-dev/mukoko-weather#148).
// No route and no workers.dev address: reached only through service bindings
// from mukoko-weather-internal and mukoko-weather-api.
//
// Names only, never values:
//   secrets: TOMORROW_API_KEY, NYUCHI_API_KEY (internal key; places read),
//            from the Secrets Store as MUKOKO_WEATHER_TOMORROW_API_KEY and
//            MUKOKO_WEATHER_NYUCHI_API_KEY (below; each one store secret
//            shared with the other Workers that need it); OPEN_METEO_API_KEY
//            (optional: the paid Open-Meteo plan), the store secret
//            OPEN_METEO_API_KEY bound as MUKOKO_WEATHER_OPEN_METEO_API_KEY
//   vars:    NYUCHI_API_URL, OPEN_METEO_ARCHIVE_LICENSED (="0": the owner's
//            plan is the lowest tier and has no historical weather API
//            (owner, 2026-11-05), so the archive calls (climate normals, the
//            place profile) stay on the free archive host. Set to "0", not
//            removed: keep_vars would keep a "1" already deployed. Set it to
//            "1" after an upgrade to a plan with the historical API. See
//            workers/README.md "Open-Meteo paid plan".)
// OWNER: replace the placeholder ids below with the created resources'
// ids (workers/README.md, "Owner steps").
{
  "name": "mukoko-weather-forecast",
  "main": "build/index.js",
  "compatibility_date": "2026-09-15",
  "build": { "command": "worker-build --release" },
  "workers_dev": false,
  "preview_urls": true,
  "keep_vars": true,
  // Traces and invocation metadata, with query strings (coordinates) redacted.
  // The code logs no payloads and no keys.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true },
  },
  // Secrets: the account's Cloudflare Secrets Store (the store id is not a
  // credential). Each secret must be in the store with the "workers" scope.
  // The code reads them by plain name through weather_edge::secret.
  // TRANSITION: until the owner confirms every value is in the store, the
  // code falls back to the plain wrangler secret of the plain name
  // (warning once per isolate); remove the fallback and the plain secrets
  // then. The binding names differ from the plain names because two
  // bindings on a Worker may not share a name.
  "secrets_store_secrets": [
    {
      "binding": "MUKOKO_WEATHER_TOMORROW_API_KEY",
      "store_id": "56f84bfa8a564c54a95dbf4f4b4281b4",
      "secret_name": "MUKOKO_WEATHER_TOMORROW_API_KEY",
    },
    {
      "binding": "MUKOKO_WEATHER_NYUCHI_API_KEY",
      "store_id": "56f84bfa8a564c54a95dbf4f4b4281b4",
      "secret_name": "MUKOKO_WEATHER_NYUCHI_API_KEY",
    },
    {
      // The paid Open-Meteo plan's key. The store secret is named
      // OPEN_METEO_API_KEY (created that way by the owner); only the binding
      // carries the app prefix. Without a key every call stays on the free
      // hosts.
      "binding": "MUKOKO_WEATHER_OPEN_METEO_API_KEY",
      "store_id": "56f84bfa8a564c54a95dbf4f4b4281b4",
      "secret_name": "OPEN_METEO_API_KEY",
    },
  ],
  "vars": {
    "NYUCHI_API_URL": "https://api.nyuchi.com",
    "OPEN_METEO_ARCHIVE_LICENSED": "0",
  },
  "kv_namespaces": [
    // Forecasts (15 min), air quality (1 h) and place lookups (1 day / 1 hour
    // for misses).
    { "binding": "FORECAST_CACHE", "id": "c7b9c50b55cd43fcbf3e077a19226109" },
  ],
  "d1_databases": [
    {
      // Validated StationKit observations, read for the `current` overlay.
      // Written by mukoko-weather-stations; schema in ../d1/migrations.
      "binding": "WEATHER_DB",
      "database_name": "mukoko-weather",
      "database_id": "9a8846ea-ee34-4479-bc4c-790ee2beabee",
      "migrations_dir": "../d1/migrations",
    },
  ],
}
