{
  "name": "mukoko-weather-astro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 0 of the move to Astro (mukoko-dev/mukoko-weather#475): the strangler app. Not deployed; the Next.js app in ../src still serves every route.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
